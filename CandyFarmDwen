-- 3. ADIM: HİLE İÇERİĞİ (CANDY FARM)
local MainTab = Window:CreateTab("Candy Farm", 4483362458)
local running = false
local yukseklikAyari = 4 
local hizAyari = 0.1 

local function enYakinYumurtayiBul()
    local char = game.Players.LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local enYakin = nil
    local enKisaMesafe = math.huge
    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name == "CandyEgg" and (v:IsA("BasePart") or v:IsA("Model")) then
            local pos = (v:IsA("Model") and v:GetModelCFrame().Position) or v.Position
            local mesafe = (char.HumanoidRootPart.Position - pos).Magnitude
            if mesafe < enKisaMesafe then
                enKisaMesafe = mesafe
                enYakin = v
            end
        end
    end
    return enYakin
end

MainTab:CreateToggle({
   Name = "Candy AutoFarm",
   CurrentValue = false,
   Callback = function(Value)
      running = Value
      local char = game.Players.LocalPlayer.Character
      if running and char and char:FindFirstChild("HumanoidRootPart") then 
          task.spawn(function()
              while running do
                  local hedef = enYakinYumurtayiBul()
                  if hedef then
                      local pos = (hedef:IsA("Model") and hedef:GetModelCFrame().Position) or hedef.Position
                      char.HumanoidRootPart.CFrame = CFrame.new(pos + Vector3.new(0, yukseklikAyari, 0))
                      task.wait(hizAyari)
                  end
                  task.wait(0.1)
              end
          end)
      end
   end,
})

MainTab:CreateSlider({
   Name = "Uçuş Yüksekliği",
   Range = {0, 5},
   Increment = 0.5,
   CurrentValue = 4,
   Callback = function(Value) yukseklikAyari = Value end,
})
